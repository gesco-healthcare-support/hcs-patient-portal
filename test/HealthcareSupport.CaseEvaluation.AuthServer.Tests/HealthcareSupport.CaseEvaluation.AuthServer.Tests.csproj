<Project Sdk="Microsoft.NET.Sdk">


  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HealthcareSupport.CaseEvaluation</RootNamespace>
  </PropertyGroup>

  <!-- Production hardening 1.8b (2026-09-01). First test project for the AuthServer.
       Created because the with-hint regression guard on the end-session handler could not
       otherwise be tested: no test project referenced the AuthServer, so its custom OpenIddict
       handlers (RevokePreviousSessionsHandler, and now RevokeSessionWithoutTokenHintHandler)
       had no coverage at all despite sitting on an auth path.
       CI needs no change: every workflow runs `dotnet test` against the solution file, so this
       project is picked up from its .slnx entry alone. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\HealthcareSupport.CaseEvaluation.AuthServer\HealthcareSupport.CaseEvaluation.AuthServer.csproj" />
    <ProjectReference Include="..\HealthcareSupport.CaseEvaluation.TestBase\HealthcareSupport.CaseEvaluation.TestBase.csproj" />
  </ItemGroup>

  <!-- Required because this is a plain Microsoft.NET.Sdk project referencing a
       Microsoft.NET.Sdk.Web one. Without it, ASP.NET Core assemblies that the Web SDK gets from
       the shared framework are instead materialised as real NuGet packages here, and NuGetAudit
       then fails the restore on Microsoft.AspNetCore.DataProtection 10.0.0
       (GHSA-9mv3-2cwr-p262) under this repo's TreatWarningsAsErrors.
       This is the documented mechanism rather than a suppression: it removes the materialised
       package instead of hiding the warning, and the AuthServer project itself restores clean
       precisely because the shared framework already provides that assembly. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>

</Project>
