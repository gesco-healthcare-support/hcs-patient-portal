<Project Sdk="Microsoft.NET.Sdk">


  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HealthcareSupport.CaseEvaluation</RootNamespace>
    <!-- 2026-11-20: the NU1904 suppression that lived here (BUG-025, GHSA-9mv3-2cwr-p262 on the
         DataProtection 10.0.0 that the HttpApi.Host reference brought in) is gone. Both hosts now take
         DataProtection.StackExchangeRedis 10.0.15, which brings the patched DataProtection, so a critical
         advisory in this project fails the restore again like everywhere else. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HealthcareSupport.CaseEvaluation.Application\HealthcareSupport.CaseEvaluation.Application.csproj" />
    <!-- BUG-025 (2026-05-21): host-module unit tests for the two
         internal static helpers (MapAppointmentDocumentErrorCodes,
         ConfigureUploadLimits) need the HttpApi.Host assembly so
         InternalsVisibleTo works. Test only references the types;
         doesn't boot the module. -->
    <ProjectReference Include="..\..\src\HealthcareSupport.CaseEvaluation.HttpApi.Host\HealthcareSupport.CaseEvaluation.HttpApi.Host.csproj" />
    <!-- Phase 3 APP-OWN-01 (2026-09-04): the resolver-chain assertion covers BOTH
         processes, so it needs the AuthServer assembly for InternalsVisibleTo.
         Same shape as the HttpApi.Host reference above: the test references the
         type, it does not boot the module.

         EXPECT LOCK-FILE CHURN FROM THIS. The reference pulls OpenIddict in
         transitively, which rewrites packages.lock.json here and in
         EntityFrameworkCore.Tests (~443 lines across the two). That is the
         reference doing its job, not a stray restore.

         It also loads the AuthServer assembly during the test run, so its lines
         enter the backend coverage denominator, which is why this PR carries the
         FLOOR_BACKEND re-baseline rather than leaving it to a follow-up. -->
    <ProjectReference Include="..\..\src\HealthcareSupport.CaseEvaluation.AuthServer\HealthcareSupport.CaseEvaluation.AuthServer.csproj" />
    <ProjectReference Include="..\HealthcareSupport.CaseEvaluation.Domain.Tests\HealthcareSupport.CaseEvaluation.Domain.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Issue 2.8 (2026-05-12) — FluentValidation main package brings
         in the TestHelper namespace (TestValidate / ShouldHaveValidationErrorFor)
         since 11.x; no separate TestHelper package needed. -->
    <PackageReference Include="FluentValidation" Version="12.1.1" />
  </ItemGroup>

</Project>
