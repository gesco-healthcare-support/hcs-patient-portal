<Project Sdk="Microsoft.NET.Sdk">


  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HealthcareSupport.CaseEvaluation</RootNamespace>
    <!-- Audit only DIRECT deps here. The Sqlite test provider pulls a transitive
         SQLitePCLRaw.lib.e_sqlite3 with a published advisory (NU1903) that failed
         restore-as-error and blocked commits. It is test-only (production runs on
         SQL Server, not SQLite), so direct-only audit is acceptable. Update the
         transitive package to a patched version to restore full auditing. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HealthcareSupport.CaseEvaluation.EntityFrameworkCore\HealthcareSupport.CaseEvaluation.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\HealthcareSupport.CaseEvaluation.Application.Tests\HealthcareSupport.CaseEvaluation.Application.Tests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.EntityFrameworkCore.Sqlite" Version="10.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- #927: the changes feed pages on rowversion and MIN_ACTIVE_ROWVERSION(), which only a real SQL Server
         has. Test-only; the tests start the image docker-compose.yml pins. MIT licensed. -->
    <PackageReference Include="Testcontainers.MsSql" Version="4.15.0" />
  </ItemGroup>

</Project>
