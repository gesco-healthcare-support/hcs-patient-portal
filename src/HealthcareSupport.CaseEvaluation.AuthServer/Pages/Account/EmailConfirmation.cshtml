@page
@model HealthcareSupport.CaseEvaluation.Pages.Account.EmailConfirmationModel
@{
    ViewData["Title"] = "Confirm your email";
}
@*
    /Account/EmailConfirmation -- the self sign-up verification email links here. GET renders only
    when the link is usable, and only shows a button: the POST behind it is what confirms the email.
    A mail scanner that opens the link (HEAD or GET) therefore confirms nothing. See
    EmailConfirmation.cshtml.cs for the measured incident behind this.

    Hidden fields carry UserId / ConfirmationToken / ReturnUrl / ReturnUrlHash through the POST.
*@

<div class="account-card">
    <div class="account-content">

        <h1 class="text-center mt-4 mb-3">Confirm your email</h1>

        <p class="mt-3">
            Press the button to confirm your email address, then sign in.
        </p>

        <form method="post" asp-page="EmailConfirmation" novalidate>
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="ConfirmationToken" />
            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" asp-for="ReturnUrlHash" />

            <div class="d-grid gap-2 mt-4">
                <button type="submit"
                        class="btn btn-primary btn-lg"
                        title="Confirm my email">
                    Confirm my email
                </button>
            </div>
        </form>

    </div>
</div>
