<Project Sdk="Microsoft.NET.Sdk">


  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HealthcareSupport.CaseEvaluation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HealthcareSupport.CaseEvaluation.Domain\HealthcareSupport.CaseEvaluation.Domain.csproj" />
    <ProjectReference Include="..\HealthcareSupport.CaseEvaluation.Application.Contracts\HealthcareSupport.CaseEvaluation.Application.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MiniExcel" Version="1.41.4" />
    <!-- G-08-03 (2026-06-06): QuestPDF renders the report + demographics PDFs in
         process (first real QuestPDF render). Version pinned to match the Domain
         reference + the Community license set in CaseEvaluationDomainModule. -->
    <PackageReference Include="QuestPDF" Version="2026.2.4" />
    <PackageReference Include="Volo.Abp.PermissionManagement.Application" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.FeatureManagement.Application" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.SettingManagement.Application" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.Account.Pro.Public.Application" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.Account.Pro.Admin.Application" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.Identity.Pro.Application" Version="10.0.2" />
    <PackageReference Include="Volo.Saas.Host.Application" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.AuditLogging.Application" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.OpenIddict.Pro.Application" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.LanguageManagement.Application" Version="10.0.2" />
    <PackageReference Include="Volo.FileManagement.Application" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.TextTemplateManagement.Application" Version="10.0.2" />
    <PackageReference Include="Volo.Abp.Gdpr.Application" Version="10.0.2" />
    <!-- Issue 2.8 (2026-05-12) — FluentValidation backend integration.
         Volo.Abp.FluentValidation auto-discovers AbstractValidator<T>
         instances and invokes them at the AppService boundary. -->
    <PackageReference Include="Volo.Abp.FluentValidation" Version="10.0.2" />
    <!-- #6 (2026-06-19): server-side HTML sanitization of IT-Admin-authored
         email-template bodies. Ganss.Xss / AngleSharp-based, MIT.
         2026-11-20: 9.0.892 -> 11.0.26. 9.0.892 failed every restore (NU1903, CSS removal
         DoS, fixed in 9.0.967). 11.x also brings AngleSharp >= 1.10, which retires the
         AngleSharp < 1.5.0 audit suppression that 9.0.x forced. Measured before the bump:
         all 63 shipped template bodies sanitize byte-identically on 9.0.892 and 11.0.26;
         ShippedEmailBodySanitizationTests pins the merge-token links for later bumps. -->
    <PackageReference Include="HtmlSanitizer" Version="11.0.26" />
  </ItemGroup>

</Project>
