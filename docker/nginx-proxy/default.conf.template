# In-house hosting (2026-07-09, T7). Reverse proxy for the subdomain-per-service
# layout. Terminates TLS on 443 and routes by Host to the internal containers,
# forwarding:
#   - the ORIGINAL Host header (the apps resolve the office from its leftmost label
#     via HostAwareDomainTenantResolveContributor -- Host is the ONLY tenant source)
#   - X-Forwarded-Proto=https so the apps see the original scheme behind TLS
#     termination (G7: OpenIddict's transport-security check + correct issuer URLs)
#
# ${BASE_DOMAIN} (e.g. portal.local locally, portal.example.com on the server) is
# substituted at container start by the nginx image's envsubst. Only variables that
# exist in the container ENVIRONMENT are substituted, so nginx's own runtime vars
# ($host, $scheme, $remote_addr, ...) are preserved -- do NOT add them to the env.
#
# server_name specificity resolves overlap: `*.api.${BASE_DOMAIN}` and
# `*.auth.${BASE_DOMAIN}` are longer (more specific) wildcards than
# `*.${BASE_DOMAIN}`, so nginx routes falkinstein.api.<domain> to the API even
# though `*.<domain>` would also match.

# Real client address behind a managed load balancer (#928).
#
# WHY THIS EXISTS. On the LAN nginx is the first hop, so $remote_addr IS the caller
# and $proxy_add_x_forwarded_for appends the right address. Put a cloud load balancer
# in front and that stops being true: the balancer becomes our peer, $remote_addr
# becomes the balancer, and every per-IP control downstream collapses into ONE bucket
# for the whole deployment -- the integration limiter (300/hr, whose stated job is
# stopping enumeration with a leaked token), external-signup register, password reset,
# document-upload-by-IP and consent. It also makes an IP allowlist impossible to
# enforce here at all, which #927 depends on.
#
# HOW IT IS SAFE. real_ip_header only rewrites $remote_addr when the CONNECTION comes
# from an address listed in set_real_ip_from, so with no such line nothing is trusted
# and nothing is rewritten. That is why the header directive can be unconditional
# while the trust list stays deployment-specific.
#
# WHICH ENTRY NGINX TAKES IS A PER-BALANCER DECISION, NOT A CONSTANT. Both settings are
# correct for some balancers and wrong for others, so this is a deployment value rather
# than something to hardcode.
#
#   recursion OFF -- nginx takes the LAST entry. Correct where the balancer appends exactly
#   ONE address, its caller. A client forging "1.2.3.4" then arrives as "1.2.3.4, <real>"
#   and the last entry wins.
#
#   recursion ON  -- nginx walks leftward, skipping entries that ARE in set_real_ip_from,
#   and stops at the first untrusted one. Required where the balancer appends MORE than one
#   address. Google Cloud's external Application Load Balancer appends TWO,
#   "<client-ip>,<load-balancer-ip>", so with recursion off nginx would take the balancer's
#   own forwarding-rule address and every caller would land in one bucket again -- which is
#   the defect this block exists to fix.
#   Ref: https://docs.cloud.google.com/load-balancing/docs/https ("X-Forwarded-For header")
#
# Recursion is SAFE here only because set_real_ip_from lists the balancer's own addresses
# and nothing else. nginx stops at the first entry outside that list, so a forged value
# further left is never reached. Widening the list to a range the balancer does not own is
# what would make it spoofable.
#
# UNVERIFIED, and worth a real request before trusting either setting: Azure Application
# Gateway writes x-forwarded-for as a comma-separated list of IP:PORT pairs, and whether
# nginx's realip module parses an address carrying a port has not been tested here.
# Ref: https://learn.microsoft.com/en-us/azure/application-gateway/how-application-gateway-works
#
# Both variables below are named WITHOUT the dollar-brace form on purpose: envsubst does not
# know a line is a comment, so writing them that way would substitute the VALUE into this
# documentation at render time. Harmless for a hostname like BASE_DOMAIN above, not harmless
# for a value that carries directives and semicolons -- and a value containing a newline
# would escape the comment entirely and become live configuration.
#
# TRUSTED_PROXY_SET_REAL_IP_FROM is EMPTY on the LAN and carries one or more
# complete directives on a cloud deployment, for example:
#   TRUSTED_PROXY_SET_REAL_IP_FROM="set_real_ip_from 10.0.0.0/16; set_real_ip_from 10.1.0.0/16;"
# Whole directives rather than bare addresses because envsubst cannot emit a line
# conditionally, and "set_real_ip_from ;" is a syntax error that would stop the proxy
# booting. Compose always DEFINES the variable (empty by default) -- an undefined one
# would be left as a literal ${...} and fail the same way.
#
# Trust only the balancer's own range. Widening it to a range the balancer does not
# own would let anything in that range set its own $remote_addr, which is exactly the
# spoofing this control exists to prevent.
real_ip_header X-Forwarded-For;
${TRUSTED_PROXY_SET_REAL_IP_FROM}
${TRUSTED_PROXY_REAL_IP_RECURSIVE}

# WebSocket upgrade passthrough (ABP SignalR notification hub).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# HTTP -> HTTPS redirect for every host.
server {
    listen 80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

# Catch-all for 443: refuse any Host that matches none of the four server blocks below.
#
# Without this, no 443 block carries `default_server`, so nginx falls back to the FIRST 443
# block in the file -- the AuthServer -- and every unmatched hostname reaches it. That is
# reconnaissance surface once the app is public.
#
# `server_name _` is not special syntax; `_` is simply a name no real Host can equal. The
# `default_server` flag is what makes this block the fallback, and nginx selects server blocks
# by NAME SPECIFICITY rather than file order (exact name, then longest `*.` wildcard, then
# suffix wildcard, then regex, and only then the default). So this block matches ONLY unmatched
# hosts and its POSITION HERE IS COSMETIC -- it sits first so a reader meets the fallback before
# the named blocks. Do not "fix" it by moving it.
#
# 421 rather than 444 (drop): HTTP/2 is on for every block below and one certificate covers
# several of these names, so a browser may coalesce connections across them. 421 is the RFC 9110
# signal telling such a client to retry on a fresh connection; 444 would give it an
# uninterpretable reset. 444 buys little concealment anyway -- port 80 already answers every
# host, and the TLS handshake announces the certificate's names before Host is ever read.
#
# The ssl_ directives are REQUIRED, not decorative: on 443 the handshake completes before Host
# is read, so this block serves the certificate whenever SNI is absent or unmatched. Without
# them the handshake cannot complete.
server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/wildcard.crt;
    ssl_certificate_key /etc/nginx/certs/wildcard.key;

    return 421;
}

# {office}.auth.<domain> -> AuthServer (OpenIddict + Razor identity UI).
server {
    listen 443 ssl;
    http2 on;
    server_name *.auth.${BASE_DOMAIN};

    ssl_certificate     /etc/nginx/certs/wildcard.crt;
    ssl_certificate_key /etc/nginx/certs/wildcard.key;

    # Uploads (profile/document flows) up to the API's 12 MB framework cap + margin.
    client_max_body_size 15m;

    location / {
        proxy_pass http://authserver:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }
}

# {office}.api.<domain> -> HttpApi.Host.
server {
    listen 443 ssl;
    http2 on;
    server_name *.api.${BASE_DOMAIN};

    ssl_certificate     /etc/nginx/certs/wildcard.crt;
    ssl_certificate_key /etc/nginx/certs/wildcard.key;

    client_max_body_size 15m;

    location / {
        proxy_pass http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }
}

# minio.<domain> -> MinIO S3 API (Case Tracker document exchange, 2026-08-13).
#
# An EXACT server_name, not a wildcard: nginx ranks exact names above every
# wildcard, so this wins over `*.${BASE_DOMAIN}` below -- which would otherwise
# serve S3 requests from the Angular container. The side effect is that `minio`
# becomes a RESERVED office slug, like `admin`.
#
# MinIO is NOT published to the host. The proxy reaches it on the compose network,
# so the only way in stays 443 here, with MinIO's own credentials as the gate.
#
# Addressing is PATH-STYLE (bucket in the path). Virtual-host addressing would put
# the bucket in the hostname, and the wildcard certificate covers a single label
# only, so `case-tracker-documents.minio.<domain>` would fail TLS.
server {
    listen 443 ssl;
    http2 on;
    server_name minio.${BASE_DOMAIN};

    ssl_certificate     /etc/nginx/certs/wildcard.crt;
    ssl_certificate_key /etc/nginx/certs/wildcard.key;

    # Objects, not form posts: medical records routinely exceed the 15m used by
    # the app vhosts. MinIO enforces its own limits, so bound it there, not here.
    client_max_body_size 0;

    # Stream both directions. Without these nginx spools whole objects to disk
    # before forwarding, which stalls large uploads and doubles disk churn.
    proxy_request_buffering off;
    proxy_buffering         off;

    # Large objects over a LAN still beat the 60s default on a slow scan.
    proxy_connect_timeout 30s;
    proxy_send_timeout    300s;
    proxy_read_timeout    300s;

    location / {
        # Re-resolve the upstream instead of caching its IP at worker start.
        # A backend rebuild moves container IPs and has silently broken routing
        # here twice; the variable form forces a lookup per request. Docker's
        # embedded DNS is 127.0.0.11. Deliberately NO URI part after the
        # variable: nginx then forwards the client's original request URI
        # unchanged, which S3 signature v4 requires -- it signs the path.
        resolver 127.0.0.11 valid=10s;
        set $minio_upstream http://minio:9000;
        proxy_pass $minio_upstream;

        proxy_http_version 1.1;
        # Signature v4 signs the Host header. Rewriting it produces signature
        # mismatches that read as bad credentials.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# {office}.<domain> -> Angular SPA (least specific; api/auth win by specificity).
server {
    listen 443 ssl;
    http2 on;
    server_name *.${BASE_DOMAIN};

    ssl_certificate     /etc/nginx/certs/wildcard.crt;
    ssl_certificate_key /etc/nginx/certs/wildcard.key;

    client_max_body_size 15m;

    location / {
        proxy_pass http://angular:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
