# In-house hosting (2026-07-09, T7). Reverse proxy for the subdomain-per-service
# layout. Terminates TLS on 443 and routes by Host to the internal containers,
# forwarding:
#   - the ORIGINAL Host header (the apps resolve the office from its leftmost label
#     via HostAwareDomainTenantResolveContributor -- Host is the ONLY tenant source)
#   - X-Forwarded-Proto=https so the apps see the original scheme behind TLS
#     termination (G7: OpenIddict's transport-security check + correct issuer URLs)
#
# ${BASE_DOMAIN} (e.g. portal.local locally, portal.example.com on the server) is
# substituted at container start by the nginx image's envsubst. Only variables that
# exist in the container ENVIRONMENT are substituted, so nginx's own runtime vars
# ($host, $scheme, $remote_addr, ...) are preserved -- do NOT add them to the env.
#
# server_name specificity resolves overlap: `*.api.${BASE_DOMAIN}` and
# `*.auth.${BASE_DOMAIN}` are longer (more specific) wildcards than
# `*.${BASE_DOMAIN}`, so nginx routes falkinstein.api.<domain> to the API even
# though `*.<domain>` would also match.

# WebSocket upgrade passthrough (ABP SignalR notification hub).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# HTTP -> HTTPS redirect for every host.
server {
    listen 80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

# {office}.auth.<domain> -> AuthServer (OpenIddict + Razor identity UI).
server {
    listen 443 ssl;
    http2 on;
    server_name *.auth.${BASE_DOMAIN};

    ssl_certificate     /etc/nginx/certs/wildcard.crt;
    ssl_certificate_key /etc/nginx/certs/wildcard.key;

    # Uploads (profile/document flows) up to the API's 12 MB framework cap + margin.
    client_max_body_size 15m;

    location / {
        proxy_pass http://authserver:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }
}

# {office}.api.<domain> -> HttpApi.Host.
server {
    listen 443 ssl;
    http2 on;
    server_name *.api.${BASE_DOMAIN};

    ssl_certificate     /etc/nginx/certs/wildcard.crt;
    ssl_certificate_key /etc/nginx/certs/wildcard.key;

    client_max_body_size 15m;

    location / {
        proxy_pass http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }
}

# minio.<domain> -> MinIO S3 API (Case Tracker document exchange, 2026-08-13).
#
# An EXACT server_name, not a wildcard: nginx ranks exact names above every
# wildcard, so this wins over `*.${BASE_DOMAIN}` below -- which would otherwise
# serve S3 requests from the Angular container. The side effect is that `minio`
# becomes a RESERVED office slug, like `admin`.
#
# MinIO is NOT published to the host. The proxy reaches it on the compose network,
# so the only way in stays 443 here, with MinIO's own credentials as the gate.
#
# Addressing is PATH-STYLE (bucket in the path). Virtual-host addressing would put
# the bucket in the hostname, and the wildcard certificate covers a single label
# only, so `case-tracker-documents.minio.<domain>` would fail TLS.
server {
    listen 443 ssl;
    http2 on;
    server_name minio.${BASE_DOMAIN};

    ssl_certificate     /etc/nginx/certs/wildcard.crt;
    ssl_certificate_key /etc/nginx/certs/wildcard.key;

    # Objects, not form posts: medical records routinely exceed the 15m used by
    # the app vhosts. MinIO enforces its own limits, so bound it there, not here.
    client_max_body_size 0;

    # Stream both directions. Without these nginx spools whole objects to disk
    # before forwarding, which stalls large uploads and doubles disk churn.
    proxy_request_buffering off;
    proxy_buffering         off;

    # Large objects over a LAN still beat the 60s default on a slow scan.
    proxy_connect_timeout 30s;
    proxy_send_timeout    300s;
    proxy_read_timeout    300s;

    location / {
        # Re-resolve the upstream instead of caching its IP at worker start.
        # A backend rebuild moves container IPs and has silently broken routing
        # here twice; the variable form forces a lookup per request. Docker's
        # embedded DNS is 127.0.0.11. Deliberately NO URI part after the
        # variable: nginx then forwards the client's original request URI
        # unchanged, which S3 signature v4 requires -- it signs the path.
        resolver 127.0.0.11 valid=10s;
        set $minio_upstream http://minio:9000;
        proxy_pass $minio_upstream;

        proxy_http_version 1.1;
        # Signature v4 signs the Host header. Rewriting it produces signature
        # mismatches that read as bad credentials.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# {office}.<domain> -> Angular SPA (least specific; api/auth win by specificity).
server {
    listen 443 ssl;
    http2 on;
    server_name *.${BASE_DOMAIN};

    ssl_certificate     /etc/nginx/certs/wildcard.crt;
    ssl_certificate_key /etc/nginx/certs/wildcard.key;

    client_max_body_size 15m;

    location / {
        proxy_pass http://angular:80;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
