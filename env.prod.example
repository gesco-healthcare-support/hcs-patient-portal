# Copy to secrets/env.prod (git-ignored) and fill in real values. NEVER commit secrets/env.prod.
# Run with: docker compose -f docker-compose.prod.yml --env-file secrets/env.prod ...
#
# (This file is named without a leading dot on purpose so it is safe to commit; the real
# env file lives under secrets/ which is git-ignored AND docker-ignored.)
#
# All values here are PLACEHOLDERS. Replace every CHANGE_ME before bringing the stack up.

# --- Domain: the office-less portal base host ---
# Local verification: portal.local (mapped in the Windows hosts file + mkcert cert).
# Server: the internal name IT provides, e.g. portal.example.com.
# Offices become {office}.<BASE_DOMAIN> / {office}.api.<BASE_DOMAIN> / {office}.auth.<BASE_DOMAIN>.
BASE_DOMAIN=portal.local
APP_NAME=Appointment Portal

# --- Reverse-proxy host ports (the ONLY service published to the host) ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Trusted proxy in front of nginx (#928) ---
# EMPTY on the LAN and on any deployment where nginx is the first hop: nginx's
# $remote_addr is already the caller, and nothing should be trusted to override it.
#
# Set this ONLY when a managed load balancer sits in front of nginx. Without it every
# per-IP control in the app collapses into one bucket for the whole deployment (the
# integration limiter, external-signup register, password reset, document upload,
# consent) and an IP allowlist cannot be enforced at the proxy at all.
#
# Whole nginx directives, not bare addresses -- envsubst cannot emit a line
# conditionally and "set_real_ip_from ;" stops the proxy booting. One per trusted
# range, semicolons included:
#   TRUSTED_PROXY_SET_REAL_IP_FROM="set_real_ip_from 10.0.0.0/16; set_real_ip_from 10.1.0.0/16;"
#
# Trust ONLY the balancer's own range. A range the balancer does not own lets anything
# inside it choose its own apparent address, which is the spoofing this prevents.
# Pair with App__TrustedProxyNetworks on the api and authserver services -- NOT the same
# value: this one is the balancer's range, that one is the network nginx connects FROM.
TRUSTED_PROXY_SET_REAL_IP_FROM=

# Empty, or exactly:  TRUSTED_PROXY_REAL_IP_RECURSIVE="real_ip_recursive on;"
#
# Which is correct depends on how many addresses the chosen balancer appends, and BOTH
# settings are wrong for some balancer:
#   - Appends ONE address (its caller): leave empty. nginx takes the last entry.
#   - Appends MORE than one: set it. Google Cloud's external Application Load Balancer
#     appends two, "<client-ip>,<load-balancer-ip>", so leaving this empty would make nginx
#     take the balancer's own address and put every caller in one bucket again.
#
# Recursion is only safe while TRUSTED_PROXY_SET_REAL_IP_FROM lists the balancer's own
# addresses and nothing else -- nginx stops at the first entry outside that list.
#
# Verify with a real request through the chosen balancer before trusting either setting.
# Azure Application Gateway writes this header as IP:PORT pairs and whether nginx's realip
# module parses a port there is untested.
TRUSTED_PROXY_REAL_IP_RECURSIVE=

# --- MinIO vhost allow-list (minio.<BASE_DOMAIN>) ---
# Who may reach the S3 API through the proxy. Whole nginx allow directives, semicolons included,
# for the same reason as the trusted-proxy variables above. Loopback is always allowed.
# LEAVE UNSET on the private network: the default is the RFC1918 ranges
#   "allow 10.0.0.0/8; allow 172.16.0.0/12; allow 192.168.0.0/16;"
# A deployment reachable from the internet must replace that default. The Azure VM CLOSES it:
#   MINIO_ALLOW_DIRECTIVES="deny all;"
# and the Case Tracker comes in through Azure Relay instead (docs/integration/case-tracker-relay.md):
# the relay listener runs in the proxy's own network namespace, so its connections arrive from
# loopback, which is always allowed. Without Relay, list only a fixed Case Tracker egress address:
#   MINIO_ALLOW_DIRECTIVES="allow 203.0.113.10;"
# and only as a last resort open it to every address ("allow all;"), when the Case Tracker's
# read-only MinIO credential and the per-address rate limit are the ONLY protection.
# An EMPTY value does NOT close the vhost: compose's ":-" default swaps it for the private ranges
# above (measured with `docker compose config`, 2026-10-13). To close it, set "deny all;". A
# non-empty value with no allow line denies everyone except loopback.
# MINIO_ALLOW_DIRECTIVES=

# Address allow-list for the documentation site at <BASE_DOMAIN>/docs/ (it has no login). Complete nginx
# allow directives; loopback is always allowed.
# LEAVE UNSET on the private network: the default is the RFC1918 ranges.
# A deployment reachable from the internet must replace that default, with the office egress
# address(es) only:
#   DOCS_ALLOW_DIRECTIVES="allow 203.0.113.20;"
# or, to publish it to no one at all (the Azure VM does not publish it):
#   DOCS_ALLOW_DIRECTIVES="deny all;"
# An EMPTY value does NOT close it: compose's ":-" default swaps it for the private ranges, which on
# an internet-facing host also admit anything reaching nginx from a Docker network (172.16.0.0/12).
# A non-empty value with no allow line denies everyone except loopback.
# DOCS_ALLOW_DIRECTIVES=

# --- TLS wildcard cert (3 SANs: *.<BASE_DOMAIN>, *.api.<BASE_DOMAIN>, *.auth.<BASE_DOMAIN>) ---
# Local: mkcert output (scripts/hosting/gen-local-certs.sh). Office server: IT internal-CA cert.
# Azure VM: Let's Encrypt, issued and renewed by scripts/hosting/renew-tls-cert.sh into these same two files.
TLS_CERT_PATH=./secrets/wildcard.crt
TLS_KEY_PATH=./secrets/wildcard.key
# Azure VM only, optional: the contact address registered with Let's Encrypt for the account.
# ACME_EMAIL=ops@example.com

# --- OpenIddict token-signing cert (G6) ---
# Generate: AUTHSERVER_CERT_PASSPHRASE=... scripts/hosting/gen-openiddict-cert.sh ./secrets/openiddict.pfx
OPENIDDICT_PFX_PATH=./secrets/openiddict.pfx
AUTHSERVER_CERT_PASSPHRASE=CHANGE_ME_openiddict_pfx_passphrase

# --- Data Protection key-ring certificate (docs/security/SESSION-KEY-ENCRYPTION.md) ---
# A SEPARATE certificate from openiddict.pfx: rotating the signing certificate signs everyone
# out, rotating this one does not, so the two are never welded together. Mounted into BOTH the
# authserver and api containers; both need it because they share one key ring.
# Generate: DATAPROTECTION_CERT_PASSPHRASE=... scripts/hosting/gen-dataprotection-cert.sh ./secrets/dataprotection.pfx
DATAPROTECTION_PFX_PATH=./secrets/dataprotection.pfx
DATAPROTECTION_CERT_PASSPHRASE=CHANGE_ME_dataprotection_pfx_passphrase

# --- Application secrets ---
# SQL SA password must meet SQL Server complexity: 8+ chars incl. upper, lower, digit, symbol.
MSSQL_SA_PASSWORD=CHANGE_ME_Strong_Sql_Passw0rd!
# The APPLICATION's SQL login (api, authserver, db-migrator). Unset = sa, which is what the office server uses.
# The Azure VM sets both, and creates the login with scripts/hosting/sql-app-login.sh after sql-server starts and
# BEFORE the migrator first runs: CREATE ANY DATABASE server-wide and nothing else, owner of the databases it
# creates. CHOOSE THE PASSWORD ONCE, before the first office exists: every office's connection string is built
# from this login and STORED in the host database (and so in every backup of it). Changing it later means
# rewriting those stored strings in the same step. At least 16 characters, upper, lower and digits; no ; ' " { }.
# Generate e.g.:  printf 'Pp-%s-Z9\n' "$(openssl rand -hex 16)"
# SQL_APP_LOGIN=portal_app
# SQL_APP_PASSWORD=
STRING_ENCRYPTION_PASSPHRASE=CHANGE_ME_16char_min_key
MINIO_ROOT_USER=CHANGE_ME_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
MINIO_BUCKET_NAME=case-evaluation-documents
# The APPLICATION credential for MinIO. NOT root: minio-init creates a user bound to a policy that
# reaches only MINIO_BUCKET_NAME (list/get/put/delete), so a leak of app config cannot administer the
# store or touch the Case Tracker bucket. Required: compose refuses to start if either is blank.
# Pick any new values (secret 8+ chars); the access key must differ from MINIO_ROOT_USER.
MINIO_APP_ACCESS_KEY=CHANGE_ME_portal_app_access_key
MINIO_APP_SECRET_KEY=CHANGE_ME_portal_app_secret_key_16+
# The Case Tracker's own bucket (2026-08-13): their staff read, write and delete
# here; the portal never touches it. Separate from ours so one access policy can
# grant them write on theirs and read-only on ours.
MINIO_CASE_TRACKER_BUCKET_NAME=case-tracker-documents
# MinIO's S3 region. Unset means us-east-1, which is what the Case Tracker was
# told to configure -- set this only if you also set MINIO_REGION on the server,
# and tell them if it ever changes.
# MINIO_REGION=us-east-1

# --- ABP licensing + private NuGet feed (needed to BUILD the .NET images on the box) ---
ABP_LICENSE_CODE=CHANGE_ME_abp_license
ABP_NUGET_API_KEY=CHANGE_ME_abp_nuget_key

# --- SMTP / email relay ---
# Production overrides the appsettings.json REPLACE_ME_LOCALLY placeholders; the .NET host reads
# these as ABP settings (Settings:Abp.Mailing.*). Without them, Production attempts delivery with
# placeholder credentials. Port 587 + STARTTLS is the tested in-house relay path.
SMTP_HOST=CHANGE_ME_smtp_host
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=CHANGE_ME_smtp_user
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_FROM_ADDRESS=CHANGE_ME_from_address
SMTP_FROM_NAME=Gesco Appointment Portal
# Backup alerts (#945): who is emailed when the off-box backup fails or stops succeeding. Sent by the host's
# backup units through the SMTP settings above, not by the app. Separate addresses with ; or ,
BACKUP_ALERT_RECIPIENTS=CHANGE_ME_ops@example.com;other@example.com

# --- Case Tracker integration ---
# All four are OPTIONAL and default to empty/30 in docker-compose.prod.yml. Leaving them unset
# is a safe state, not a broken one: sending is additionally gated per office by the
# CaseTrackerPushEnabled ABP setting (default false), an unset BaseUrl fails as a transport
# error the outbox records rather than posting ePHI somewhere unintended, and an unset
# IntegrationToken makes the reconcile endpoint refuse EVERY request instead of serving PHI.
#
# BASE_URL must be https before any real patient data flows -- the payload is ePHI. The
# http form below is usable only for synthetic-data testing.
# INTAKE_TOKEN is issued by the Case Tracker team to us (sent as X-Intake-Token on each push).
# INTEGRATION_TOKEN is issued by us to them (required on the reconcile GET).
# FEED_ALERT_RECIPIENTS receives the changes-feed alerts (#927) and the weekly missing-intake report (#944).
CASE_TRACKER_BASE_URL=CHANGE_ME_case_tracker_base_url
CASE_TRACKER_INTAKE_TOKEN=CHANGE_ME_token_from_case_tracker_team
CASE_TRACKER_INTEGRATION_TOKEN=CHANGE_ME_token_we_issue_to_them
CASE_TRACKER_FEED_TOKEN=CHANGE_ME_separate_feed_token_we_issue_to_them
CASE_TRACKER_FEED_ALERT_RECIPIENTS=CHANGE_ME_alerts@example.com;other@example.com
CASE_TRACKER_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Admin passwords (B12)
#
# Each database's admin password is GENERATED on first use and kept in a store,
# rather than being the published default this product used to seed everywhere.
#
# Set EXACTLY ONE of these. With neither, or with both, the migrator and the API
# refuse to start and name both keys -- deliberately, because a host with no
# store would seed a published password and report a successful start, and a host
# with two has entries in one that the other cannot see.
#
#   ADMIN_PASSWORD_DIRECTORY  a folder on this box, one file per database, mode
#                             0600. This is the self-hosted default and is
#                             already mounted by docker-compose.prod.yml.
#   ADMIN_PASSWORD_VAULT_URI  an Azure Key Vault. Leave EMPTY here.
#
# BEFORE THE FIRST DEPLOY, create the folder owned by the container user. The
# migrator and the API run as `app` (uid 1654). A bind-mount source Docker creates
# itself is owned by root, the first write then fails, the migrator exits and the
# API never starts. From the repository root on the server:
#
#   mkdir -p secrets/admin-passwords
#   sudo chown 1654:1654 secrets/admin-passwords
#   chmod 700 secrets/admin-passwords
#
# WHICH FILES ARE VALID. An entry is written only when it is used: when the
# migrator creates a database's admin, or when it rotates an admin still on a
# published default (it logs "Rotated the admin password of <database>"). An
# office made through the New Practice screen, or one whose admin already has
# its own password, gets NO entry, and its admin recovers access through
# forgot-password. Each rotated admin must change the password at first sign-in,
# so after that the file is only the handover value, not the live password.
#
# Back the directory up with the database dumps anyway: until that first
# sign-in, a restored database's admin can be signed into with its entry only.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD_DIRECTORY=/run/admin-passwords
ADMIN_PASSWORD_VAULT_URI=

# --- DbMigrator environment ---
# Production = no test-data seeding (real deploy). The local-seed override forces
# Development for the CHECKPOINT 1 fast path. Do NOT set Development on the server.
DBMIGRATOR_ENVIRONMENT=Production

# --- Backups (T13) ---
# Host destination for nightly .bak files (bind-mounted into the SQL container). On the server,
# point this at an access-controlled, OFF-BOX location (e.g. a mounted network share). The .bak
# files contain PHI. Retention prunes .bak files older than BACKUP_RETENTION_DAYS.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# --- Off-server backup to Azure Blob (Azure VM only) ---
# Read by scripts/hosting/backup-azure-blob.sh, not by any container. Leave these unset on the office
# server, which ships its backups with backup-offbox.sh instead. Authentication is the VM's managed
# identity: there is deliberately NO storage key here. Retention lives on the storage account, not here.
AZURE_BACKUP_STORAGE_ACCOUNT=
AZURE_BACKUP_DB_CONTAINER=db-backups
AZURE_BACKUP_DOCUMENTS_CONTAINER=documents
AZURE_BACKUP_BUCKETS=case-evaluation-documents
# Only for a user-assigned identity; leave empty to use the VM's system-assigned identity.
AZURE_BACKUP_MSI_CLIENT_ID=

# --- Azure Relay listener for the Case Tracker's document reads (Azure VM only; off until used) ---
# Read by scripts/hosting/relay-listener.sh, not by any container. Design: docs/integration/case-tracker-relay.md.
# The listener signs in with the VM's managed identity: there is deliberately no key here. The image is loaded
# from the azbridge release tarball (sha256-checked) and pinned by the id `docker image inspect` printed.
# RELAY_NAMESPACE=
# RELAY_HYBRID_CONNECTION=case-tracker-documents
# RELAY_AZBRIDGE_IMAGE=
# RELAY_AZBRIDGE_IMAGE_ID=
# Fallback only, if the managed identity cannot listen: a mode-600 file holding
# AZURE_BRIDGE_CONNECTIONSTRING=<the vm-listen SAS connection string>
# RELAY_LISTEN_CONNECTION_STRING_FILE=

# --- SQL Server edition ---
# Unset means Developer, which is licensed for development and testing ONLY. Any deployment that
# holds real patient data must set a production edition. Express is free and is what the Azure VM
# uses; it caps each database at 10 GB and the buffer pool at about 1.4 GB. A paid Standard licence
# key also goes here. Confirm what is actually running after the first start, rather than trusting
# this file: SELECT SERVERPROPERTY('Edition') must not say Developer.
# MSSQL_PID=Express

# --- Resource limits (T6) ---
# Caps for the 16 GB / 4 vCPU box so no container (especially SQL) can starve the
# others. MSSQL_MEMORY_LIMIT_MB hard-caps SQL's process memory; SQL_MEM_LIMIT is the
# container ceiling (a little above, for non-buffer-pool overhead). Tune down for a
# smaller box.
MSSQL_MEMORY_LIMIT_MB=7168
SQL_MEM_LIMIT=10g
API_MEM_LIMIT=2g
AUTHSERVER_MEM_LIMIT=1500m
PACKET_RENDERER_MEM_LIMIT=1500m
# B11: clamd needs 3 GiB minimum, 4 GiB preferred (ClamAV's guidance).
CLAMAV_MEM_LIMIT=4g
